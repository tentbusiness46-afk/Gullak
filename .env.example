# ============================================================
# Gullak backend - environment configuration
# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.
# ============================================================

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database ----
# Local testing: leave DB_URL as the local file URL below. This creates
# a SQLite file at ./data/gullak.db - no extra setup needed.
#
# Deployment (Turso): replace both values with the ones from
# `turso db show <db-name>` / `turso db tokens create <db-name>`.
# See docs/TURSO_SETUP.md for the full walkthrough.
DB_URL=file:./data/gullak.db
DB_AUTH_TOKEN=

# ---- Auth secrets ----
# Generate strong random values for these, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value for each secret, and different values again in
# production vs. local dev.
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-different-long-random-string

# ---- Admin bootstrap ----
# There is no admin row seeded into the database. The single admin
# account is defined entirely by these two variables and checked
# directly on login. To rotate the admin password, change this value
# and restart the server - no migration needed.
ADMIN_EMAIL=admin@gullak.in
ADMIN_PASSWORD=change-this-before-deploying

# ---- Cookie / cross-origin behaviour ----
# Set to "true" only when serving the app over HTTPS (i.e. in
# production). Leave "false" for local http://localhost testing, since
# secure cookies are silently dropped by browsers over plain HTTP.
COOKIE_SECURE=false

# ---- OTP (demo mode) ----
# In demo mode the correct code is always the phone number's last 4
# digits (no real SMS provider wired up yet) - the "sent" code is also
# logged to the console for convenience. Set DEMO_OTP_MODE=false and
# wire up a real SMS provider in src/utils/otp.js before taking real
# user signups.
DEMO_OTP_MODE=true
